PLANTGUARD_ENVIRONMENT=development
PLANTGUARD_CORS_ORIGINS=http://localhost:5173
PLANTGUARD_DATABASE_URL=postgresql+psycopg://plantguard:plantguard@localhost:5432/plantguard
PLANTGUARD_MAX_IMAGE_BYTES=10485760
PLANTGUARD_MAX_IMAGE_PIXELS=25000000
PLANTGUARD_PHOTO_STORAGE_PATH=.data/photos
PLANTGUARD_PHOTO_URL_TTL_SECONDS=900
PLANTGUARD_PHOTO_SIGNING_KEY=development-only-photo-signing-key

# Optional broad identification. Create a free key at https://my.plantnet.org/
# Without the key PlantGuard keeps using the bundled offline baseline.
PLANTGUARD_PLANTNET_API_KEY=
PLANTGUARD_PLANTNET_PROJECT=all
PLANTGUARD_PLANTNET_LANGUAGE=ru
PLANTGUARD_PLANTNET_TIMEOUT_SECONDS=12
PLANTGUARD_PLANTNET_RECOGNITION_THRESHOLD=0.55
PLANTGUARD_PLANTNET_MAX_RESULTS=5
VITE_API_URL=http://localhost:8000

POSTGRES_DB=plantguard
POSTGRES_USER=plantguard
POSTGRES_PASSWORD=plantguard
