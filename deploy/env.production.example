PLANTGUARD_DOMAIN=plantguard.example.com
PLANTGUARD_IMAGE_TAG=latest

POSTGRES_DB=plantguard
POSTGRES_USER=plantguard
POSTGRES_PASSWORD=replace-with-a-long-random-password

PLANTGUARD_PHOTO_SIGNING_KEY=replace-with-at-least-32-random-characters
PLANTGUARD_MAX_IMAGE_BYTES=10485760
PLANTGUARD_MAX_IMAGE_PIXELS=25000000
PLANTGUARD_PHOTO_URL_TTL_SECONDS=900

# Optional broad plant identification. Leave empty to use only the local model.
PLANTGUARD_PLANTNET_API_KEY=
PLANTGUARD_PLANTNET_PROJECT=all
PLANTGUARD_PLANTNET_LANGUAGE=ru
PLANTGUARD_PLANTNET_TIMEOUT_SECONDS=12
PLANTGUARD_PLANTNET_RECOGNITION_THRESHOLD=0.55
PLANTGUARD_PLANTNET_MAX_RESULTS=5

# Optional compatible LLM endpoint. Leave all three values empty for safe local explanations.
PLANTGUARD_LLM_BASE_URL=
PLANTGUARD_LLM_API_KEY=
PLANTGUARD_LLM_MODEL=
