{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plantguard.local/contracts/plant-identification-result.v1.schema.json",
  "title": "Plant identification completed",
  "x-kafka-topic": "plant.identification-results.v1",
  "x-kafka-key": "plant_id",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "observation_id",
    "plant_id",
    "candidates",
    "needs_review",
    "model_version"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "plant.identification.completed" },
    "schema_version": { "const": 1 },
    "occurred_at": {
      "type": "integer",
      "minimum": 0,
      "description": "Unix time in milliseconds"
    },
    "observation_id": { "type": "string", "format": "uuid" },
    "plant_id": { "type": "string", "format": "uuid" },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scientific_name", "confidence"],
        "properties": {
          "scientific_name": { "type": "string", "minLength": 1, "maxLength": 160 },
          "common_name": { "type": ["string", "null"], "maxLength": 160 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "needs_review": { "type": "boolean" },
    "model_version": { "type": "string", "minLength": 1, "maxLength": 120 }
  }
}
